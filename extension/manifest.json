{
  "manifest_version": 3,
  "name": "Dueboard Sync",
  "version": "0.2.0",
  "description": "Синхронізує дедлайни Dueboard з вашим календарем Moodle.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://learn.ucu.edu.ua/*",
    "https://dueboard.xyz/*",
    "https://www.dueboard.xyz/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://dueboard.xyz/*", "https://www.dueboard.xyz/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dueboard-page.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://learn.ucu.edu.ua/*"],
      "js": ["moodle-page.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Dueboard Sync" }
}
